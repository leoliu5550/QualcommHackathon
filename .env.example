# FileOrg Environment Variables Configuration

# ============================================================================
# General Settings
# ============================================================================

# Environment mode: "development" or "production"
# - development: Verbose logging to console and file
# - production: Minimal logging to file only
FILEORG_ENV=production

# ============================================================================
# TURU API Configuration (for NPU acceleration)
# ============================================================================

# TURU API endpoint URL
# Default: http://127.0.0.1:8000/v1
TURU_BASE_URL=http://127.0.0.1:8000/v1

# TURU model to use (should match available models in TURU server)
# Default: .bot/Llama 3.1 8B @NPU
# Common NPU models:
#   - .bot/Llama 3.1 8B @NPU
#   - .bot/Llama 3.2 3B @NPU
#   - .bot/Qwen 2.5 7B @NPU
TURU_MODEL=.bot/Llama 3.1 8B @NPU

# TURU API key for authentication
# Default: API_KEY
TURU_API_KEY=API_KEY

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
# Default: 0.1
TURU_TEMPERATURE=0.1

# Request timeout in seconds
# Default: 600.0 (10 minutes)
TURU_TIMEOUT=600.0

# ============================================================================
# ONNX Model Configuration (for ONNX Runtime inference)
# ============================================================================

# ONNX model name (leave empty for auto-detection)
# If set, uses the specified model from fileorg/llm_classifier/models/
# If empty, automatically detects any exported ONNX model
# Default: (empty - auto-detect)
# Examples:
#   - Llama-3.2-3B-Instruct
#   - Llama-3.2-1B-Instruct
#ONNX_MODEL_NAME=

# Auto-download ONNX model on first run if not found
# Default: true
# Set to false if you want to manually export/download models
ONNX_AUTO_DOWNLOAD=true

# GitHub release tag for model download
# Used by fileorg-download-model command
# Default: latest
# Examples:
#   - model-v1.0.0
#   - model-v1.1.0
#ONNX_RELEASE_TAG=latest

# ============================================================================
# Usage Instructions
# ============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env with your configuration
#
# 3. The .env file will be automatically loaded by fileorg
#
# 4. Verify TURU is detected:
#    fileorg organize --path /your/directory --preview
#    (Should show "Detected TURU API server" in logs)
#
