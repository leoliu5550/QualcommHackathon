[run]
branch = True
source = fileorg
omit = 
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*
    */.venv/*
    */venv/*
    setup.py
    */__init__.py
    */conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstract
    @abstractmethod
    except ImportError
    except ModuleNotFoundError
    if sys.platform
    if os.name
    logger.debug
    logging.debug
    if self.debug:
    if settings.DEBUG

skip_covered = False
skip_empty = True
precision = 2
sort = Cover
show_missing = True

[html]
directory = htmlcov
title = FileOrg Coverage Report

[xml]
output = coverage.xml

[json]
output = coverage.json
pretty_print = True

[paths]
source =
    fileorg/
    */site-packages/fileorg
    */fileorg