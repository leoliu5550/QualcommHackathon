# Coverage.py configuration file
# https://coverage.readthedocs.io/en/latest/config.html

[run]
# Measure branch coverage in addition to statement coverage
branch = True

# Source packages to measure
source = fileorg

# Patterns to omit from coverage
omit = 
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*
    */.venv/*
    */venv/*
    setup.py
    */migrations/*
    */config/*
    */settings/*
    */__init__.py
    */conftest.py

# Enable parallel mode for combining coverage from multiple processes
parallel = True

# Context for coverage (useful for test suite analysis)
context = ${CONTEXT}

[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    # Standard pragma
    pragma: no cover
    
    # Debugging-related code
    def __repr__
    def __str__
    
    # Assertions
    raise AssertionError
    raise NotImplementedError
    
    # Defensive programming
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    
    # Abstract methods
    @abstract
    @abstractmethod
    
    # Optional dependencies
    except ImportError
    except ModuleNotFoundError
    
    # Platform-specific code
    if sys.platform
    if os.name
    
    # Logging
    logger.debug
    logging.debug
    
    # Testing code
    if self.debug:
    if settings.DEBUG

# Skip files with 100% coverage in the report
skip_covered = False

# Skip empty files
skip_empty = True

# Precision for coverage percentages
precision = 2

# Sort report by coverage percentage
sort = Cover

# Show missing line numbers
show_missing = True

[html]
# Directory for HTML report
directory = htmlcov

# Title for the HTML report
title = FileOrg Coverage Report

[xml]
# Output file for XML report (for CI tools)
output = coverage.xml

[json]
# Output file for JSON report
output = coverage.json

# Pretty print JSON
pretty_print = True

[paths]
# Map paths for combining coverage from different environments
source =
    fileorg/
    */site-packages/fileorg
    */fileorg

[tool:coverage]
# Additional plugins (if needed)
# plugins = 

# Data file for storing coverage information
data_file = .coverage

# Parallel mode filename pattern
# parallel_filename_pattern = .coverage.*